__pycache__/
*.pyc

# The combined single-file mockup build. Rebuilt by
# `python3 mockups/build-single-file.py`; the script is committed, the artefact
# is not, so the two can never drift apart.
mockups/dosing-wizard-v2-mockups.html

# The Python runtime the application uses to run the engine in a browser.
# Fetched and hash-verified by `python3 tools/app/vendor-runtime.py`; the
# script is committed, the 12 MB artefact is not, on the same principle as the
# single-file mockup build above.
app/vendor/pyodide/

# The deploy tree, assembled by tools/app/build-deploy-tree.py.
# Derived from the source, 13 MB, and rebuilt in one command — committing it
# would put a second copy of the application in the repository, which is the
# drift this whole approach exists to prevent.
deploy/

# The zipped deploy tree, for a drag-and-drop host. Derived from the tree,
# which is derived from the source. Rebuilt in two commands.
*.zip
