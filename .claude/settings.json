{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Edit(./docs/canon/**)",
      "Bash(git push origin main)",
      "Bash(git push origin main:*)",
      "Bash(git push origin HEAD:main)",
      "Bash(git push -f *)",
      "Bash(git push --force*)",
      "Bash(gh pr merge *)",
      "mcp__github__merge_pull_request",
      "mcp__github__enable_pr_auto_merge"
    ],
    "ask": [
      "Bash(git push *)"
    ]
  }
}
